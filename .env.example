# Exemplo de variáveis de ambiente
# Copie este arquivo para .env e configure conforme necessário

# Modo Debug (mostra logs detalhados)
# DEBUG_MODE=true

# Proxy para contornar bloqueios geográficos (opcional)
# Formate: http://usuario:senha@proxy:porta
# Exemplo: YT_DLP_PROXY=http://proxy.example.com:8080
# YT_DLP_PROXY=

# Para Streamlit Cloud, configure essas variáveis em:
# ⚙️ Configurações → Secrets
